<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<wsdl:definitions xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:tns="http://www.example.org/ServicioIdentidad/" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" name="ServicioIdentidad" targetNamespace="http://www.example.org/ServicioIdentidad/">
  <wsdl:types>
    <xsd:schema targetNamespace="http://www.example.org/ServicioIdentidad/">
      <xsd:element name="AutenticarUsuario">
        <xsd:complexType>
          <xsd:sequence>
          	<xsd:element name="correo" type="xsd:string" maxOccurs="1" minOccurs="1"/>
          	<xsd:element name="contraseña" type="xsd:string" maxOccurs="1" minOccurs="1"></xsd:element>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="AutenticarUsuarioResponse">
        <xsd:complexType>
          <xsd:sequence>
          	<xsd:element name="ok" type="xsd:boolean" maxOccurs="1"
          		minOccurs="1" />
          	<xsd:element name="mensaje" type="xsd:string" maxOccurs="1" minOccurs="0"></xsd:element>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="VerificarPrivilegios">
      	<xsd:complexType>
      		<xsd:sequence>

      			<xsd:element name="correo" type="xsd:string" maxOccurs="1" minOccurs="1"></xsd:element>
      			<xsd:element name="nivel" type="xsd:string" maxOccurs="1" minOccurs="1"></xsd:element>
      		</xsd:sequence>
      	</xsd:complexType>
      </xsd:element>
      <xsd:element name="VerificarPrivilegiosResponse">
      	<xsd:complexType>
      		<xsd:sequence>

      			<xsd:element name="ok" type="xsd:boolean" maxOccurs="1" minOccurs="1"></xsd:element>
      			<xsd:element name="mensaje" type="xsd:string" maxOccurs="1" minOccurs="1"></xsd:element>
      		</xsd:sequence>
      	</xsd:complexType>
      </xsd:element>
    
        
        </xsd:schema>
  </wsdl:types>
  <wsdl:message name="AutenticarUsuarioRequest">
    <wsdl:part element="tns:AutenticarUsuario" name="parameters"/>
  </wsdl:message>
  <wsdl:message name="AutenticarUsuarioResponse">
    <wsdl:part element="tns:AutenticarUsuarioResponse" name="parameters"/>
  </wsdl:message>
  <wsdl:message name="VerificarPrivilegiosRequest">
  	<wsdl:part name="parameters" element="tns:VerificarPrivilegios"></wsdl:part>
  </wsdl:message>
  <wsdl:message name="VerificarPrivilegiosResponse">
  	<wsdl:part name="parameters" element="tns:VerificarPrivilegiosResponse"></wsdl:part>
  </wsdl:message>
  <wsdl:portType name="ServicioIdentidad">
    <wsdl:operation name="AutenticarUsuario">
      <wsdl:input message="tns:AutenticarUsuarioRequest"/>
      <wsdl:output message="tns:AutenticarUsuarioResponse"/>
    </wsdl:operation>
    <wsdl:operation name="VerificarPrivilegios">
    	<wsdl:input message="tns:VerificarPrivilegiosRequest"></wsdl:input>
    	<wsdl:output message="tns:VerificarPrivilegiosResponse"></wsdl:output>
    </wsdl:operation>
  </wsdl:portType>
  <wsdl:binding name="ServicioIdentidadSOAP"
  	type="tns:ServicioIdentidad">
  	<soap:binding style="document"
  		transport="http://schemas.xmlsoap.org/soap/http" />
  	<wsdl:operation name="AutenticarUsuario">
  		<soap:operation
  			soapAction="http://www.example.org/ServicioIdentidad/AutenticarUsuario" />
  		<wsdl:input>
  			<soap:body use="literal" />
  		</wsdl:input>
  		<wsdl:output>
  			<soap:body use="literal" />
  		</wsdl:output>
  	</wsdl:operation>
  	<wsdl:operation name="VerificarPrivilegios">
  		<soap:operation
  			soapAction="http://www.example.org/ServicioIdentidad/VerificarPrivilegios" />
  		<wsdl:input>
  			<soap:body use="literal" />
  		</wsdl:input>
  		<wsdl:output>
  			<soap:body use="literal" />
  		</wsdl:output>
  	</wsdl:operation>
  </wsdl:binding>
  <wsdl:service name="ServicioIdentidad">
    <wsdl:port binding="tns:ServicioIdentidadSOAP" name="ServicioIdentidadSOAP">
      <soap:address location="http://www.example.org/"/>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>
